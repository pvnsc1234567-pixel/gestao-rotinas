# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

FLASK_APP=run.py
FLASK_DEBUG=1

# SQLite (padrão, não precisa instalar nada). O arquivo é criado na pasta "instance/".
DATABASE_URL=sqlite:///rotinas.db

# Exemplos para outros bancos (instale o driver correspondente):
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/rotinas
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/rotinas
